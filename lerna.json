{
  "npmClient": "npm",
  "useWorkspaces": true,
  "version": "independent",
  "packages": ["modules/*"],
  "command": {
    "version": {
      "conventionalCommits": true,
      "allowBranch": ["dev", "release"],
      "preid": "beta",
      "message": "chore(release): publish [skip ci]"
    }
  }
}
